#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

config TESTING_LTP
	tristate "Linux Test Project"
	default n
	---help---
		Enable support for the Linux Test Project(LTP) framework

if TESTING_LTP

config TESTING_LTP_STACKSIZE
	int "Linux Test Project stack size"
	default 8192

config TESTING_LTP_KERNEL
	bool "Enable LTP Linux kernel test cases"
	default n
	---help---
		Build the Linux kernel test cases under testcases/kernel.

		These tests require additional NuttX compatibility support,
		including loop devices, netdb, and Linux helper APIs.  Keep
		this disabled until those dependencies are available.

endif #TESTING_LTP
